{
  "name": "@hexmote/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "NEXT_DEV_WRANGLER_ENV=preview next dev",
    "build": "next build",
    "build:worker": "./scripts/build-worker.sh",
    "preview": "NEXT_DEV_WRANGLER_ENV=preview bun run build:worker --env preview && opennextjs-cloudflare preview --env preview --port 3000",
    "deploy": "bun run build:worker && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "bun run cf-typegen && next typegen && tsc --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hexmote/contracts": "workspace:*",
    "@hexmote/domain": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi-client": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "jose": "^6.2.13",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "catalog:",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "wrangler": "^4.152.0"
  },
  "trustedDependencies": []
}
