{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hexmote-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "COOLDOWN_MS": "10000", "RESET_AFTER_MS": "21600000" },
  "secrets": {
    "required": [
      "SESSION_SIGNING_KEY",
      "TURNSTILE_SECRET_KEY",
      "BUDGET_PER_DAY",
      "BUDGET_PER_CYCLE",
      "BILLING_CYCLE_DAY"
    ]
  },
  "durable_objects": {
    "bindings": [{ "name": "CANVAS", "class_name": "Canvas" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Canvas"] }]
}
